# Copy to .env and set unique values. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-value
ADAPTIVE_DATABASE_URL=postgresql+psycopg://adaptive:replace-with-a-long-random-value@postgres:5432/adaptive
ADAPTIVE_FRONTEND_ORIGIN=http://localhost:8080
ADAPTIVE_COOKIE_SECURE=false
ADAPTIVE_STORAGE_PROVIDER=filebase
ADAPTIVE_BLOCKCHAIN_DAILY_LIMIT=10
ADAPTIVE_BLOCKCHAIN_PER_USER_DAILY_LIMIT=2
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET=

# Blockchain is disabled unless explicitly configured and requested by the user.
# Set network to local or sepolia; do not use mainnet for the demonstration.
ETHEREUM_NETWORK=
ETHEREUM_CHAIN_ID=
SEPOLIA_RPC_URL=
SEPOLIA_DEPLOYER_PRIVATE_KEY=
CID_REGISTRY_ADDRESS=
